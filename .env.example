# ---------------------------------------------------------------------------
# IdentityForge — environment template
# Copy to .env.local and fill in. NEVER commit the filled version.
# ---------------------------------------------------------------------------

# Walrus Memory credentials — generate at https://memory.walrus.xyz
# Note the variable name: MEMWAL_PRIVATE_KEY, not MEMWAL_KEY.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=

# Public managed relayer. Staging: https://relayer-staging.memory.walrus.xyz
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Active namespace. Forget rotates this forward (identity -> identity_v2 -> ...).
MEMWAL_NAMESPACE=identity

# ---------------------------------------------------------------------------
# Models.
#
# The default configuration below uses only FREE TIERS and deliberately picks
# models from different families: Gemini for the agent, Llama via Groq for the
# portability swap. A swap between two models of one lineage proves much less
# than a swap between two lineages, and using open-weight agents also hedges the
# case where the hackathon track restricts the model choice — verify the rules.
#
# Providers: anthropic | gemini | groq | openrouter | openai | deepseek
# Anything not `anthropic` speaks the OpenAI-compatible wire format.
# ---------------------------------------------------------------------------

# Primary agent model.
LLM_PRIMARY_PROVIDER=openrouter
LLM_PRIMARY_MODEL=openai/gpt-6.1-sol

# Second agent model, used for condition C3 (portability). Must differ from
# the primary model AND the judge, or the experiment measures nothing.
LLM_SECONDARY_PROVIDER=groq
LLM_SECONDARY_MODEL=openai/gpt-oss-120b

# Offline judge. Must differ from BOTH agent models — the harness refuses to run
# otherwise, because the eval would be scoring itself.
LLM_JUDGE_PROVIDER=openrouter
LLM_JUDGE_MODEL=google/gemini-2.5-flash-lite

# Request budget guard. Some OpenRouter and free-tier keys cap the token budget
# under 8192, so keep this small enough for the provider that is currently active.
LLM_MAX_TOKENS=4000

# Provider keys — you only need the two used above.
GEMINI_API_KEY=
GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# Override the base URL for any OpenAI-compatible provider.
# OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# Sui — for the public on-chain ownership link shown in the evidence panel.
# The account object id is the same value as MEMWAL_ACCOUNT_ID.
# ---------------------------------------------------------------------------
SUI_NETWORK=mainnet
