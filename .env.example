# ---------------------------------------------------------------------------
# IdentityForge — environment template
# Copy to .env.local and fill in. NEVER commit the filled version.
# ---------------------------------------------------------------------------

# Walrus Memory credentials — generate at https://memory.walrus.xyz
# Note the variable name: MEMWAL_PRIVATE_KEY, not MEMWAL_KEY.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=

# Public managed relayer. Staging: https://relayer-staging.memory.walrus.xyz
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Active namespace. Forget rotates this forward (identity -> identity_v2 -> ...).
MEMWAL_NAMESPACE=identity

# ---------------------------------------------------------------------------
# Models. Swap per request to prove portability (H2) and keep the judge
# distinct from both agent models.
# Verify your provider is eligible under the hackathon rules before submitting.
# ---------------------------------------------------------------------------

# Primary agent model. Provider is inferred from the key prefix.
#   ANTHROPIC_API_KEY -> Anthropic (default, no extra config)
#   DEEPSEEK_API_KEY  -> DeepSeek
#   OPENAI_API_KEY    -> OpenAI-compatible endpoint (OpenRouter, Llama, Qwen...)
LLM_PRIMARY_PROVIDER=anthropic
LLM_PRIMARY_MODEL=claude-opus-5

# Second agent model, used for condition C3 (portability). Must differ from
# the primary, or the model-swap experiment measures nothing.
LLM_SECONDARY_PROVIDER=anthropic
LLM_SECONDARY_MODEL=claude-sonnet-5

# Offline judge. Must differ from BOTH agent models — the harness refuses to run
# if the judge is also an agent model, because then the eval scores itself.
LLM_JUDGE_PROVIDER=anthropic
LLM_JUDGE_MODEL=claude-haiku-4-5-20251001

# Provider keys
ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# Sui — for the public on-chain ownership link shown in the evidence panel.
# The account object id is the same value as MEMWAL_ACCOUNT_ID.
# ---------------------------------------------------------------------------
SUI_NETWORK=mainnet
